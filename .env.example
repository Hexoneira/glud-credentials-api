# Copia este archivo a `.env` y ajusta los valores para tu entorno local:
#   cp .env.example .env
# Spring Boot lo carga automáticamente al arrancar (ver application.yaml).
# Las variables de entorno reales del SO tienen prioridad sobre este archivo.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/credentials
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT: en local usa un secreto largo cualquiera; en producción usa uno aleatorio y seguro
# Genera uno con: openssl rand -base64 48
JWT_SECRET=k5oD8hP5mWg9p5NzT5y8aTU1DpxHiP7xWROpNuXIkub
JWT_EXPIRATION=86400000

# Semilla TOTP global (misma en todos los entornos del despliegue)
RANDOM_SEED=dev-random-seed
TENANT=GLUD
TOTP_WINDOW=1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4321

# Límites de invitados
GUEST_MAX_ACTIVE=15
GUEST_ACCESS_DURATION=PT2H
GUEST_RETENTION=P21D
