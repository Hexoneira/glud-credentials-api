# Configuracion de entorno para el API GLUD Credentials
# Copia este archivo a .env y ajusta los valores

# --- Base de datos (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/credentials
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Seguridad JWT ---
# Cadena en Base64 de al menos 32 bytes (256 bits)
# Genera una con: openssl rand -base64 48
JWT_SECRET=k5oD8hP5mWg9p5NzT5y8aTU1DpxHiP7xWROpNuXIkub
# Duracion del token en milisegundos (default: 24 horas)
JWT_EXPIRATION=86400000

# --- TOTP (generacion de seeds) ---
# Secreto del servidor usado para derivar seeds de invitados
RANDOM_SEED=
# Codigo del tenant raiz
TENANT=GLUD

# --- CORS ---
# Origenes permitidos para peticiones cross-origin (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4321
